# ═══════════════════════════════════════════════════════════════════════
# NEXUS OSINT — configuración de ejemplo
# Copia este archivo a `.env` y rellena lo que necesites.
# Todas las claves son OPCIONALES salvo las marcadas [REQUERIDO].
# Sin clave, esa fuente simplemente devuelve 0 eventos (no rompe el barrido).
# ═══════════════════════════════════════════════════════════════════════

# ─── Seguridad [REQUERIDO en producción] ───
# Cambia estos valores antes de exponer el dashboard fuera de 127.0.0.1
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esto_ya
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXP_HOURS=24

# Permite acceso sin login SOLO desde loopback (127.0.0.1). Pon 0 para forzarlo siempre.
NEXUS_LOCAL_NOAUTH=1

# ─── Retención y ventana ───
# Días de histórico que se conservan (0 = nunca borrar). Por defecto 120.
NEXUS_RETENTION_DAYS=120

# ─── LLM (opcional) ───
# Sin esto, la pestaña «IA» muestra un aviso. Modelo: gpt-4o-mini.
OPENAI_API_KEY=

# ─── Telegram (opcional) ───
# Crea un bot con @BotFather y obtén el chat_id con @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── GeoIP (opcional) ───
# Descarga GeoLite2-City.mmdb desde maxmind.com (gratis con cuenta).
# Si no existe, se usa ip-api.com/batch (respetando su límite de 15 req/min).

# ─── Fuentes OSINT con API key (todas opcionales) ───

# abuse.ch — Auth-Key gratis en https://auth.abuse.ch/
# Necesario para URLhaus, ThreatFox y MalwareBazaar.
ABUSECH_AUTH_KEY=

# NASA FIRMS — clave gratuita en https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_MAP_KEY=

# OpenSky Network — cuenta gratuita en https://opensky-network.org/
OPENSKY_USER=
OPENSKY_PASS=

# FRED (St. Louis Fed) — clave en https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# EIA (US Energy Information Administration)
EIA_API_KEY=

# ACLED — registro en https://developer.acleddata.com/
ACLED_EMAIL=
ACLED_PASSWORD=

# AISStream (tráfico marítimo)
AISSTREAM_API_KEY=

# ADS-B Exchange (vuelos militares)
ADSB_API_KEY=

# ReliefWeb — appname aprobado en https://apidoc.reliefweb.int
RELIEFWEB_APPNAME=

# OpenSanctions — clave en https://www.opensanctions.org/api/
OPENSANCTIONS_API_KEY=

# Ransomware.live — clave en https://www.ransomware.live/
RANSOMWARE_LIVE_KEY=

# Cloudflare Radar (DDoS origen/destino) — token con permiso Radar
CLOUDFLARE_API_TOKEN=

# ─── Frontend (avanzado) ───
# URL alternativa a deck.gl (por defecto usa CDN jsDelivr/unpkg).
# NEXUS_DECK_URL=
# GeoJSON de países (por defecto Natural Earth 110m, ~250 KB).
# NEXUS_LAND_URL=
# Destino de los arcos del mapa (por defecto Washington D.C.).
# NEXUS_ARC_TARGET=38.9072,-77.0369
# Máximo de puntos en el mapa (por defecto 1500).
# NEXUS_MAP_POINTS=1500
